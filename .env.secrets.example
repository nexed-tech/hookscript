# Copy this file to .env.secrets (untracked, stays only on this host) and
# fill in real values. Required for the `cft` / `cft-<port>` tag to configure
# a Cloudflare Tunnel ingress rule + DNS record for a container.
#
# CF_API_TOKEN needs, at minimum:
#   - Account: Cloudflare Tunnel: Edit (to update the tunnel's ingress config)
#   - Zone: DNS: Edit (for every zone containers will be exposed under)

CF_API_TOKEN=changeme
CF_ACCOUNT_ID=changeme
CF_TUNNEL_ID=changeme
