# Copy this file to .env.secrets (untracked, stays only on this host) and
# fill in real values. Each feature below only runs if its own keys are
# present, so it's fine to fill in some sections and leave others blank.

# Required for the `cft` / `cft-<port>` tag to configure a Cloudflare Tunnel
# ingress rule + DNS record for a container.
#
# CF_API_TOKEN needs, at minimum:
#   - Account: Cloudflare Tunnel: Edit (to update the tunnel's ingress config)
#   - Zone: DNS: Edit (for every zone containers will be exposed under)

CF_API_TOKEN=changeme
CF_ACCOUNT_ID=changeme
CF_TUNNEL_ID=changeme

# Required to sync the Linux Update Dashboard's SSH public key into every
# container's authorized_keys on every start/reboot (no tag - applies to all
# containers). Rotate the key here; it takes effect on each container's next
# start/reboot. LUD_SSH_USER defaults to root if left unset.

LUD_SSH_PUBKEY=changeme
#LUD_SSH_USER=root
