# This service runs once at boot and daily
# It pulls the latest hookscript + mounts.yaml from Gitea

# place in /etc/systemd/system/hooksync.timer
# systemctl daemon-reload
# systemctl enable hooksync.timer

[Unit]
Description=Run hookscript sync daily and at boot

[Timer]
OnBootSec=5min
OnUnitActiveSec=1d
Persistent=true

[Install]
WantedBy=timers.target