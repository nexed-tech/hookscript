# This service runs once at boot
# It pulls the latest hookscript + mounts.yaml from Gitea, then re-syncs the
# APT sources/config/keys into every running container (apt.yaml)

# place in /etc/systemd/system/hooksync.service
# systemctl daemon-reload
# systemctl enable hooksync.service

[Unit]
Description=Update Proxmox hookscript from Gitea
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/lib/vz/snippets
ExecStart=-/bin/sh -c '/usr/bin/git pull && echo "$(date) - $(/usr/bin/git rev-parse HEAD)" >> /var/log/hooksync.log'
# "-" on the pull above: still sync with the current checkout if the pull failed
ExecStart=/usr/bin/perl /var/lib/vz/snippets/hookscript.pl apt-sync-all
User=root

[Install]
WantedBy=multi-user.target
